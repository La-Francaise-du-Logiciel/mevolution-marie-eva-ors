# =========================================================================
#  Mévolution — configuration publique du build de production
#
#  Ce fichier est versionné À DESSEIN, contrairement à `.env.local` : il ne
#  contient aucun secret, seulement l'URL publique du site, qui finit de
#  toute façon en clair dans le HTML (canonicals, Open Graph, sitemap).
#
#  Il sert de valeur par défaut pour que le build ne dépende pas d'une
#  configuration invisible dans le tableau de bord Vercel. Une variable
#  définie côté plateforme reste prioritaire sur ce fichier : renseigner
#  NEXT_PUBLIC_SITE_URL dans Vercel écrase donc la valeur ci-dessous, sans
#  aucune modification de code.
#
#  ⚠️ À METTRE À JOUR le jour où le domaine définitif est branché sur le
#  projet Vercel (celui prévu est https://www.mevolution-consulting.fr,
#  déjà déposé mais pas encore rattaché). Tant que ce n'est pas fait, les
#  canonicals doivent désigner le domaine réellement servi, sous peine de
#  pointer vers une adresse qui ne répond pas.
# =========================================================================

NEXT_PUBLIC_SITE_URL=https://mevolution-marie-eva-ors.vercel.app

# Les autres variables (Resend, PostHog) restent volontairement non
# renseignées ici : ce sont des secrets, ils n'ont rien à faire dans le
# dépôt et doivent être définis dans les variables d'environnement Vercel.

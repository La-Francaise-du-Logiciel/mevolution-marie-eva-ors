# =========================================================================
#  Mévolution — variables d'environnement
#  Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# =========================================================================

# --- Site -----------------------------------------------------------------
# URL de production (sans slash final). Sert aux canonicals, OG, sitemap.
NEXT_PUBLIC_SITE_URL=https://www.mevolution-consulting.fr

# --- Resend (formulaire de contact) --------------------------------------
# Clé API SERVEUR (jamais exposée au client — pas de préfixe NEXT_PUBLIC_).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Adresse qui reçoit les messages du formulaire.
CONTACT_TO_EMAIL=mevolution-consulting@outlook.fr
# Expéditeur (doit être un domaine vérifié dans Resend).
CONTACT_FROM_EMAIL="Mévolution <contact@mevolution-consulting.fr>"

# --- PostHog (analytics) --------------------------------------------------
# Utiliser un projet PostHog Cloud EU et activer dans ses réglages :
# Project Settings > Web analytics > Cookieless server hash mode.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
